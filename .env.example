# Hugging Face token used to download the gated MedGemma and MedTE models.
# Any one of these names works; the first one set wins.
HUGGINGFACE_API_KEY=
# HF_TOKEN=
# HUGGINGFACE_HUB_TOKEN=

# Path to the cleaned hospital MRF CSV (machine-readable file).
PT_MRF_CSV=everyUPMCmrf_clean.csv

# Directory of the local Qdrant store containing `cpt_medte` / `hcpcs_medte`.
PT_QDRANT_PATH=New_PT_DB

# Number of candidates retrieved per code family.
PT_TOP_K=10
