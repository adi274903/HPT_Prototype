# ---------------------------------------------------------------------------
# HPT prototype settings
#
# This file is OPTIONAL and can live anywhere: the working directory (where a
# notebook's load_dotenv() looks), Colab's /content, or the repo root are all
# searched, in that order. Point PT_ENV_FILE at a specific file to override the
# search.
#
# Precedence: a real environment variable or Colab secret always beats this file
# (it is loaded with override=False). Values are read when the pipeline is
# built, not at import, so loading this file late still takes effect.
# ---------------------------------------------------------------------------

# Hugging Face token for the gated MedGemma / MedTE models.
# Any one of these names works; the first one set wins.
HUGGINGFACE_API_KEY=
# HF_TOKEN=
# HUGGINGFACE_HUB_TOKEN=

# --- Data paths ------------------------------------------------------------
# In Colab these are typically Drive or /content paths, e.g.
#   PT_MRF_CSV=/content/drive/MyDrive/Price_Transparency/datasets/everyUPMCmrf_clean (1).csv
#   PT_QDRANT_PATH=/content/New_PT_DB
PT_MRF_CSV=everyUPMCmrf_clean.csv
PT_QDRANT_PATH=New_PT_DB

# --- Retrieval -------------------------------------------------------------
PT_TOP_K=10
# PT_CPT_COLLECTION=cpt_medte
# PT_HCPCS_COLLECTION=hcpcs_medte

# --- Models ----------------------------------------------------------------
# PT_MEDGEMMA_MODEL=google/medgemma-1.5-4b-it
# PT_EMBED_MODEL=MohammadKhodadad/MedTE-cl15-step-8000

# --- Inference backend -----------------------------------------------------
# Which generator load_models() builds. All four run in this process except
# "remote"; none of them starts a server.
#   transformers  bfloat16 weights through transformers.pipeline (default)
#   llamacpp      a GGUF through llama_cpp.Llama      -> also set PT_LLM_GGUF
#   vllm          weights through vllm.LLM
#   remote        an OpenAI-compatible server someone else runs -> PT_LLM_BASE_URL
# PT_LLM_BACKEND=transformers
# PT_LLM_GGUF=/content/medgemma-1.5-4b-it-Q4_K_M.gguf
# PT_LLM_N_GPU_LAYERS=-1
# PT_LLM_MAX_MODEL_LEN=8192
# PT_LLM_BASE_URL=http://127.0.0.1:8080/v1
# PT_LLM_MODEL=google/medgemma-1.5-4b-it
# PT_LLM_API_KEY=
# PT_LLM_TIMEOUT=600

# --- Prompt / generation limits --------------------------------------------
# PT_MAX_CANDIDATES=8
# PT_CANDIDATE_TEXT_LIMIT=120
#
# Per-step token budgets are dynamic: prompt_tokens * factor + slack, floored
# and then capped. Raise the cap, or pin one step to a constant:
# PT_MAX_NEW_TOKENS=4096
# PT_MAX_NEW_TOKENS_DECIDE=2048
# PT_MAX_NEW_TOKENS_CATEGORIZE=
# PT_MAX_NEW_TOKENS_ANSWER=

# --- .env discovery --------------------------------------------------------
# PT_ENV_FILE=/content/my.env
